{
  "manifest_version": 3,
  "name": "AI Media Extractor",
  "version": "0.5.6",
  "description": "Extract media assets and optionally auto-download newly generated images and videos.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.doubao.com/*",
    "https://www.dola.com/*",
    "https://vas-lf-x.snssdk.com/*",
    "https://www.qianwen.com/*",
    "https://qianwen.my.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/thread/*",
        "https://www.doubao.com/chat/*",
        "https://www.dola.com/chat/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.doubao.com/thread/*",
        "https://www.doubao.com/chat/*",
        "https://www.dola.com/chat/*",
        "https://www.qianwen.com/chat/*",
        "https://www.qianwen.com/share/chat/*",
        "https://qianwen.my.cn/share/chat/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "homepage_url": "https://github.com/scj725/ai-media-extractor"
}
